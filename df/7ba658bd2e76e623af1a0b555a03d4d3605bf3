o_channel</span> <span style=3D"color: #007a9f;">seq</span> <span style=3D"=
color: #007a9f;">oc</span> =3D
  <span style=3D"color: #242521; font-weight: bold;">let</span> <span style=
=3D"color: #007a9f;">state</span> =3D <span style=3D"color: #557400; font-w=
